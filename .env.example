PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
REDIS_URL=rediss://USER:PASSWORD@HOST:PORT
NASA_API_KEY=YOUR_NASA_FIRMS_MAP_KEY
ADMIN_TOKEN=GENERATE_AT_LEAST_32_RANDOM_BYTES
ALLOWED_ORIGINS=https://your-web-domain.example
FIREBASE_SERVICE_ACCOUNT_BASE64=BASE64_ENCODED_SERVICE_ACCOUNT_JSON
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
DISABLE_BACKGROUND_JOBS=false
